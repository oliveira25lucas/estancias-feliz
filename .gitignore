# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# O .env.example é a documentação das variáveis e não tem segredo nenhum:
# só nomes, comentários e valores vazios. Sem esta linha o `.env*` acima
# engolia ele, e o `cp .env.example .env.local` do README não funcionava
# em clone novo — o arquivo não existia no repositório.
!.env.example

# vercel
.vercel

# supabase — cache local da CLI, não é configuração do projeto
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Os originais das fotos em alta ficam versionados em /fotos/ (237 MB).
# Eles NAO vao para a Vercel: quem barra o upload e o .vercelignore, senao
# cada deploy subiria 237 MB a toa. O site so usa /public/fotos/.
