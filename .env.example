# ============================================================
#  Sítio Estâncias Feliz — variáveis de ambiente
#
#  Copie para .env.local e preencha. NUNCA versione o .env.local.
#  Na Vercel, cadastre as mesmas chaves em Settings > Environment Variables.
# ============================================================

# ---------- Banco de dados (Supabase) ----------
# Use o MESMO projeto que o n8n já usa, para o painel enxergar as reservas
# criadas pela Júlia no WhatsApp.
# Onde achar: Supabase > Project Settings > Data API / API Keys.
SUPABASE_URL=https://jmundnnugyqqwahugjxt.supabase.co

# Chave service_role — ignora o RLS. Só no servidor, nunca no navegador,
# e nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Painel administrativo ----------
# Senha para entrar em /admin. Escolha uma senha longa e única.
ADMIN_SENHA=

# Segredo que assina o cookie de sessão. Gere com:
#   openssl rand -hex 32
ADMIN_SECRET=

# ---------- Integração com o agente do WhatsApp ----------
# Token que o n8n envia no cabeçalho x-api-token ao chamar /api/consultar.
# É por essa rota que a Júlia descobre preço e disponibilidade — sem ela,
# o agente volta a inventar valores. Gere com:
#   openssl rand -hex 32
API_TOKEN=

# ---------- Avisos automáticos de WhatsApp ----------
# Sem EVOLUTION_KEY nenhum aviso é enviado: o site registra no log e
# segue funcionando. É a mesma apikey da credencial "Header Auth account"
# do n8n, usada pelo nó "Enviar WhatsApp".
EVOLUTION_KEY=

# Só preencha se mudar de servidor ou de instância. Os padrões já são
# api.estanciasfeliz.com.br e sitio-atendimento — a mesma instância em que
# a Júlia atende, para o aviso sair do número que todos conhecem.
# EVOLUTION_URL=https://api.estanciasfeliz.com.br
# EVOLUTION_INSTANCIA=sitio-atendimento

# JID do grupo dos donos ("Aluguel Sítio Estâncias Feliz"). Não é número
# de telefone: é um id que termina em @g.us. Descubra o seu com
#   node scripts/listar-grupos.mjs
GRUPO_DONOS_JID=

# WhatsApp da faxineira, com DDI e DDD (ex.: 5531900000000).
FAXINEIRA_WHATSAPP=

# Autentica o cron da Vercel em /api/cron/lembretes. A Vercel manda esta
# chave sozinha, no cabeçalho Authorization, quando a variável existe.
# Gere com:
#   openssl rand -hex 32
CRON_SECRET=

# ---------- Disparo de WhatsApp para o lead do site ----------
# ESTA É A ÚNICA AUTOMAÇÃO QUE ESCREVE PARA UM CLIENTE sem que ele tenha
# mandado mensagem antes. A Evolution é WhatsApp Web automatizado, não a
# API oficial: volume anormal para quem nunca escreveu é o caminho mais
# curto para o número ser banido — e é o mesmo número em que a Júlia
# atende todo mundo.
#
# Por isso o disparo é OPT-IN. Vazia ou com qualquer outro valor, nada é
# enviado e o site registra no log. Aceita 1, true ou sim.
LEAD_WHATSAPP_ATIVO=

# Teto de mensagens para lead por dia, somando o primeiro contato e as
# retomadas. Padrão 30 quando não definida.
# LEAD_WHATSAPP_TETO_DIARIO=30

# ---------- Manutenção do n8n (opcional) ----------
# O site NÃO lê esta chave e ela não precisa existir na Vercel. Fica no
# .env.local só para atualizar o workflow v4 pela API pública, no cabeçalho
# X-N8N-API-KEY. Gere em n8n → Settings → n8n API.
# N8N_API_KEY=
